{
  "productName": "Salary Clock for Mac",
  "identifier": "com.hmilyhyun.salaryclock",
  "build": {
    "beforeBuildCommand": "npm run tauri -- icon src-tauri/icons/salary-clock.svg --output src-tauri/target/macos-icons && npm run build:desktop"
  },
  "bundle": {
    "targets": ["dmg"],
    "createUpdaterArtifacts": false,
    "icon": ["target/macos-icons/32x32.png", "target/macos-icons/icon.icns"],
    "publisher": "Hmilyhyun",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
